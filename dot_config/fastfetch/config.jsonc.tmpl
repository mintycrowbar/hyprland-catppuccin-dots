// execute with: fastfetch --colors-block-range-start 9 --colors-block-width 3

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "{{ .chezmoi.homeDir }}/.config/fastfetch/ascii/miku",
        "padding": {
            "top": 2,
            "right": 6
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
	    {
            "type": "title",
            "keyWidth": 10,
            "color": {
                "user": "92",  // Red
                "at": "1",    // Red
                "host": "94"   // Red
            }
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "91"  // = color3
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "91"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "91"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "91"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "91"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "91"
        },
        {
            "type": "gpu",
            "key": " ",
            "keyColor": "91"
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "91"
        }
    ]
}
