# The `monitor` attribute sets on which monitor that element will be displayed. Set it according to your actual monitor setup (if you want a specific element to only show on one of your monitors, then specify it by `monitor = <monitor-id>`). If blank, it will show on both.

source = {{ .chezmoi.homeDir }}/.config/hypr/mocha.conf

$accent = $mauve
$accentAlpha = $mauveAlpha
$font = JetBrainsMono Nerd Font

# GENERAL
general {
    disable_loading_bar = true
    hide_cursor = true
}

# BACKGROUND
background {
    monitor =
    path = {{ .chezmoi.homeDir }}/.config/backgrounds/shaded.png
    blur_passes = 2
    color = $base
}

# TIME
label {
    monitor =
    text = cmd[update:30000] echo "$(date +"%R")"
    color = $text
    font_size = 30
    font_family = $font
    position = 0, 250
    halign = center
    valign = center
}

# DATE 
label {
    monitor =
    text = cmd[update:43200000] echo "$(date +"%A, %d %B")"
    color = $text
    font_size = 25
    font_family = $font
    position = 0, 200
    valign = center
    halign = center
}

# USER AVATAR
image {
    monitor =
    path = {{ .chezmoi.homeDir }}/.avatar.jpg
    size = 100
    border_color = $accent
    position = 0, 70
    halign = center
    valign = center
}

# INPUT FIELD
input-field {
    monitor =
    size = 300, 60
    outline_thickness = 3
    rounding = 1
    dots_size = 0.2
    dots_spacing = 0.2
    dots_center = true
    outer_color = $accent
    inner_color = $surface0
    font_color = $text
    fade_on_empty = false
    placeholder_text = <span foreground="##$textAlpha">Logged in as <span foreground="##$accentAlpha">$USER</span></span>
    hide_input = false
    check_color = $accent
    fail_color = $red
    fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i>
    capslock_color = $yellow
    position = 0, -40
    halign = center
    valign = center
}

# text
label {
	monitor =
	text = ^q^
	position = 0, -350
	font_family = $font
}
