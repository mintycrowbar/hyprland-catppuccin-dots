# mako notification daemon configuration file

# Dimensions
width=300
height=200
font=monospace 13

# Notification rules
default-timeout=5000
ignore-timeout=1

# Colors
text-color=#cdd6f4
border-radius=0
background-color=#2b2b3cff
border-color=#f5e0dc

[urgency=high]
default-timeout=100000
background-color=#9b2b2bff
text-color=#fafafa
border-color=#fafafa
border-size=4

[urgency=normal]
background-color=#2b2b3cff
border-color=#f5e0dc

[urgency=low]
background-color=#13131eff
border-color=#a8a8a8ff

[category=mpd]
default-timeout=2000
group-by=category
